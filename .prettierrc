{
  "singleQuote": true,
  "trailingComma": "all",
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports"
  ],
  "importOrder": [
    "<BUILTIN_MODULES>",
    "",
    "^@nestjs/(.*)$",
    "",
    "<THIRD_PARTY_MODULES>",
    "",
    "^[./].*\\.module$",
    "",
    "^[./].*\\.controller$",
    "",
    "^[./].*\\.service$",
    "",
    "^[./].*\\.operation$",
    "",
    "^[./].*\\.repository$",
    "",
    "^[./].*\\.(schema|dto|types)$",
    "",
    "^[./]"
  ],
  "importOrderParserPlugins": [
    "typescript",
    "decorators-legacy"
  ]
}